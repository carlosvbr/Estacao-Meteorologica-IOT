  {
    "id": "fn_previsao",
    "type": "function",
    "z": "tab_estacao",
    "name": "Formatar previsao",
    "func": "const d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst icones = {\n  'Tempestade': '⛈️', 'Chuva forte': '🌧️', 'Chuva': '🌧️',\n  'Nublado, chuva prov.': '🌦️', 'Nublado': '☁️',\n  'Parcial. nublado': '⛅', 'Ensolarado': '☀️',\n  'Ensolarado e quente': '🔥☀️'\n};\nconst icone = icones[d.previsao] || '🌡️';\n\nlet seta = '→';\nif (d.tendencia > 0.3) seta = '↑';\nelse if (d.tendencia < -0.3) seta = '↓';\n\nreturn [\n  { payload: `${icone} ${d.previsao}` },\n  { payload: d.pressao },\n  { payload: `${seta} ${d.tendencia} hPa (fonte: ${d.fonte})` },\n  { payload: d.cidade }\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 480,
    "wires": [
