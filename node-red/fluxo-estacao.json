  {
    "id": "fn_separar",
    "type": "function",
    "z": "tab_estacao",
    "name": "Separar dados",
    "func": "const d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst temp  = { payload: d.temperatura };\nconst umid  = { payload: d.umidade };\nconst gas   = { payload: d.gasPct };\n\n// grafico historico: uma mensagem por serie (topic = nome da linha)\nconst grafico = [\n  { topic: 'Temperatura (C)',     payload: d.temperatura },\n  { topic: 'Umidade (%)',         payload: d.umidade },\n  { topic: 'Indice de calor (C)', payload: d.indiceCalor }\n];\n\nconst conforto = { payload: `${d.indiceCalor} C - ${d.conforto}` };\nconst luz      = { payload: `${d.lux} lux - ${d.luz}` };\nconst ar       = { payload: `${d.qualidadeAr} (${d.gasPct}%)` };\nconst alerta   = { payload: d.alerta };\n\n// notificacao (toast) somente quando o alerta muda\nlet toast = null;\nconst anterior = context.get('alertaAnterior') || 'Nenhum';\nif (d.alerta !== anterior) {\n  context.set('alertaAnterior', d.alerta);\n  if (d.alerta && d.alerta !== 'Nenhum') {\n    toast = { topic: 'ALERTA - Estacao', payload: d.alerta };\n  }\n}\n\nconst hora = { payload: d.dataHora || '--' };\n\nreturn [temp, umid, gas, grafico, conforto, luz, ar, alerta, toast, hora];",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 160,
    "wires": [
      [
        "ui_g_temp"
      ],
      [
        "ui_g_umid"
      ],
      [
        "ui_g_gas"
      ],
      [
